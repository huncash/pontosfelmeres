# pontosfelmeres.hu – másolás: cp .env.example .env
# Titkot, jelszót és API-kulcsot ne tegyél a verziókezelt fájlba.

SITE_NAME=Pontosfelmérés
SITE_URL=https://pontosfelmeres.hu

# A site-6 saját portja: pontosfelmeres.hu → 6000.
# site-7 (3dscantobim.hu) → 7000, site-8 (hatekony3dfelmeres.hu) → 8000.
PORT=6000
NODE_ENV=production

# Csak akkor 1, ha a 6000-es portot kizárólag a reverse proxy éri el.
TRUST_PROXY=0

# Saját sqlite fájl. Ne mutasson másik site adatbázisára vagy feltöltési könyvtárára.
DATA_FILE=./data/leads.sqlite
# Alternatíva a DATA_FILE helyett:
# DATABASE_URL=sqlite:./data/leads.sqlite

CONTACT_EMAIL=info@pontosfelmeres.hu
CONTACT_PHONE=+36 30 667 2510

COMPANY_LEGAL_NAME=ADP-TOP Kereskedelmi és Szolgáltató Kft.
COMPANY_SHORT_NAME=ADP-TOP Kft.
COMPANY_SEAT=1116 Budapest, Híradó utca 29.
COMPANY_REG_NUMBER=01-09-872622
COMPANY_COURT=Fővárosi Törvényszék Cégbírósága
COMPANY_TAX_ID=13777164-2-43
COMPANY_EU_TAX_ID=HU13777164
COMPANY_ACTIVITY=4712 – Iparcikk jellegű vegyes kiskereskedelem

# Közzététel előtt töltsd ki a tényleges tárhelyszolgáltatóval.
HOSTING_PROVIDER=
HOSTING_ADDRESS=
HOSTING_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SEND_CUSTOMER_COPY=true

# Legalább 16 karakter. A lenti példa szándékosan nem fogadható el.
ADMIN_TOKEN=cserelje-le-egy-hosszu-veletlen-szovegre
SESSION_SECRET=

RETENTION_MONTHS=24
